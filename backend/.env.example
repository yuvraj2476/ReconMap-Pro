# ReconMap Pro backend configuration
RECONMAP_ENVIRONMENT=development
RECONMAP_DEBUG=false
RECONMAP_HOST=0.0.0.0
RECONMAP_PORT=8000

# Database: SQLite (default, zero-dependency) or PostgreSQL
RECONMAP_DATABASE_URL=sqlite+aiosqlite:///./reconmap.db
# RECONMAP_DATABASE_URL=postgresql+asyncpg://reconmap:reconmap@localhost/reconmap

# Redis (optional; leave empty for in-process queue)
RECONMAP_REDIS_URL=
# RECONMAP_REDIS_URL=redis://localhost:6379/0

# CORS
RECONMAP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Recon behaviour
RECONMAP_REQUEST_TIMEOUT=10
RECONMAP_MAX_CRAWL_DEPTH=3
RECONMAP_MAX_CRAWL_PAGES=75
RECONMAP_MAX_CONCURRENT_REQUESTS=8
RECONMAP_PASSIVE_ONLY=false

# SAFETY: only enable private networks when scanning the bundled local Docker lab
RECONMAP_ALLOW_PRIVATE_NETWORKS=false

RECONMAP_REPORT_DIR=./reports
